{
  "info": {
    "_postman_id": "db4056cf-b66f-4e3c-b87c-937f68372f23",
    "name": "CoffeeNChill Part 3 - Deployment checks (Thami)",
    "description": "Deployment checks for the Docker stack and the live VPS. Run folder 0 first.",

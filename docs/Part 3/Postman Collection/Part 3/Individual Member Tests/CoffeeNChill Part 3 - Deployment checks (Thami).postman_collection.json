  "item": [
    {
      "name": "0 Setup (run first)",
      "item": [
        {
          "name": "S0 - Login Admin",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Test script attribution: pattern adapted from Postman's documentation on writing test scripts (Postman, 2025).",
                  "pm.test(\"Admin login returns 200 and a token\", () => {",
                  "  pm.response.to.have.status(200);",
                  "  const json = pm.response.json();",
                  "  pm.expect(json.token).to.be.a(\"string\");",
                  "  pm.collectionVariables.set(\"adminToken\", json.token);",
                  "  pm.collectionVariables.set(\"token\", json.token);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "S1 - Create Staff account (201, or 409 if it already exists)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminToken}}",
                  "type": "string"
                }

    {
      "name": "4 Deployment checks",
      "item": [
        {
          "name": "P1 - Health check, public (200, fast)",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "health"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Test script attribution: pattern adapted from Postman's documentation on writing test scripts (Postman, 2025).",
                  "pm.test(\"Health returns 200 in under 3 seconds\", () => {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.responseTime).to.be.below(3000);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "P2 - Swagger page opens (200)",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{siteUrl}}/swagger/index.html",
              "host": [
                "{{siteUrl}}"
              ],
              "path": [
                "swagger",
                "index.html"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Test script attribution: pattern adapted from Postman's documentation on writing test scripts (Postman, 2025).",
                  "pm.test(\"Swagger page returns 200 and is the Swagger UI\", () => {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.text().toLowerCase()).to.include(\"swagger\");",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "P3 - OpenAPI file lists the endpoints (200)",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{siteUrl}}/swagger/v1/swagger.json",
              "host": [
                "{{siteUrl}}"
              ],
              "path": [
                "swagger",
                "v1",
                "swagger.json"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Test script attribution: pattern adapted from Postman's documentation on writing test scripts (Postman, 2025).",
                  "pm.test(\"OpenAPI document returns 200 and lists at least 15 paths\", () => {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(Object.keys(pm.response.json().paths).length).to.be.at.least(15);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "P4 - Public menu (200)",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/menu",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "menu"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Test script attribution: pattern adapted from Postman's documentation on writing test scripts (Postman, 2025).",
                  "pm.test(\"Public menu returns 200\", () => {",
                  "  pm.response.to.have.status(200);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "P5 - Protected route without a token (401 JSON)",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/orders",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "orders"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Test script attribution: pattern adapted from Postman's documentation on writing test scripts (Postman, 2025).",
                  "pm.test(\"No token gives 401 with the JSON error shape\", () => {",
                  "  pm.response.to.have.status(401);",
                  "  pm.expect(pm.response.json().error).to.be.a(\"string\");",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "P6 - Unknown route (404 JSON from the middleware)",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/this-route-does-not-exist",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "this-route-does-not-exist"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Test script attribution: pattern adapted from Postman's documentation on writing test scripts (Postman, 2025).",
                  "pm.test(\"Unknown route gives 404 with a JSON body\", () => {",
                  "  pm.response.to.have.status(404);",
                  "  pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"json\");",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "P7 - Wrong method on login (405 JSON)",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Test script attribution: pattern adapted from Postman's documentation on writing test scripts (Postman, 2025).",
                  "pm.test(\"GET on the login route gives 405 with a JSON body\", () => {",
                  "  pm.response.to.have.status(405);",
                  "  pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"json\");",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "P8 - Login gives a real JWT (starts with eyJ, 3 parts)",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{customerEmail}}\",\n  \"password\": \"{{customerPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Test script attribution: pattern adapted from Postman's documentation on writing test scripts (Postman, 2025).",
                  "pm.test(\"Login returns 200 and a token that starts with eyJ and has 3 parts\", () => {",
                  "  pm.response.to.have.status(200);",
                  "  const token = pm.response.json().token;",
                  "  pm.expect(token.startsWith(\"eyJ\")).to.be.true;",
                  "  pm.expect(token.split(\".\").length).to.eql(3);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "P9 - Customer token is refused on a staff route (403)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{customerToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/documents",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "documents"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Test script attribution: pattern adapted from Postman's documentation on writing test scripts (Postman, 2025).",
                  "pm.test(\"Customer gets 403 on the staff documents route\", () => {",
                  "  pm.response.to.have.status(403);",
                  "});"
                ]
              }
            }
          ]
        }
      ],
      "description": "Checks that are about the running server, not about one feature: health, Swagger, the OpenAPI file, JSON errors, real JWT. Run on Local (Docker) and on VPS Live."
    }
  ],

            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Barista Staff\",\n  \"email\": \"{{staffEmail}}\",\n  \"password\": \"{{staffPassword}}\",\n  \"role\": \"Staff\"\n}",

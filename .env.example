# Copy this file to a file named .env (same folder) and fill in the values. The .env file is NEVER committed.
# These are the settings that docker-compose.yml reads (Docker, 2026k).

# Which image version to run. v3.0 normally. v3.0-test for images built on your own PC.
IMAGE_TAG=v3.0

# The secret that signs the login tokens. At least 32 characters. Use a long random text on the real server.
JWT_KEY=change-me-to-a-long-random-text-of-at-least-32-characters

# The first Admin account, created automatically when the gateway starts.
SEED_ADMIN_EMAIL=admin@coffeenchill.ac.za
SEED_ADMIN_PASSWORD=change-me-to-a-strong-password